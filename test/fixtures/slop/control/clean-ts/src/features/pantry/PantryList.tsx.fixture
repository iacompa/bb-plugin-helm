import { useMemo, useState } from "react";
import { t } from "@app/i18n";
import { daysLeft } from "./expiry";
import type { PantryItem } from "./schema";

interface Props {
  items: PantryItem[];
  onRemove: (id: string) => void;
}

export function PantryList({ items, onRemove }: Props) {
  const [query, setQuery] = useState("");
  const visible = useMemo(() => items.filter((i) => i.name.toLowerCase().includes(query.toLowerCase())), [items, query]);
  const today = new Date();

  return (
    <section>
      <input type="search" placeholder={t("searchPlaceholder")} aria-label={t("searchPlaceholder")} value={query} onChange={(e) => setQuery(e.target.value)} />
      {visible.length === 0 ? (
        <p>{t("empty")}</p>
      ) : (
        <ul>
          {visible.map((item) => (
            <li key={item.id}>
              <span>{item.name}</span>
              <span>
                {item.quantity} {item.unit}
              </span>
              {daysLeft(item, today) <= 3 && <strong>{t("expiresSoon").replace("{days}", String(daysLeft(item, today)))}</strong>}
              <button onClick={() => onRemove(item.id)}>{t("remove")}</button>
            </li>
          ))}
        </ul>
      )}
    </section>
  );
}
