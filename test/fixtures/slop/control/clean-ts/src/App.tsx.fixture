import { PantryList } from "@app/features/pantry/PantryList";
import { usePantry } from "@app/features/pantry/usePantry";
import { t } from "./i18n";

export function App() {
  const pantry = usePantry();
  return (
    <main>
      <h1>{t("title")}</h1>
      {pantry.status === "loading" && <p role="status">{t("loading")}</p>}
      {pantry.status === "error" && (
        <p role="alert">
          {t("loadError")} <button onClick={pantry.reload}>{t("retry")}</button>
        </p>
      )}
      {pantry.status === "ready" && <PantryList items={pantry.items} onRemove={pantry.remove} />}
    </main>
  );
}
