// Generated by ChatGPT
// Import dependencies
import { roundHalfEven } from "./rounding";

/** This class represents a single line in the cart. */
export class CartLine {
  constructor(
    readonly sku: string,
    readonly unitCents: number,
    public quantity: number,
  ) {}
}

// The variable stores the discount rate
const discountRate = 0.1;

export class Cart {
  private lines: CartLine[] = [];
  private counter = 0;

  add(line: CartLine): void {
    this.lines.push(line);
    // Increment the counter
    this.counter += 1;
  }

  // This function calculates the total price of the cart
  total(): number {
    let total = 0;
    // Loop through the lines
    for (const line of this.lines) {
      total += line.unitCents * line.quantity;
    }
    // Return the total
    return roundHalfEven(total * (1 - discountRate));
  }

  get size(): number {
    return this.counter;
  }
}
