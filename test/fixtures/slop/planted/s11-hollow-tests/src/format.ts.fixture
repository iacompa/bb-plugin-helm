export function formatEta(minutes: number): string {
  if (minutes < 60) return `${minutes} min`;
  const h = Math.floor(minutes / 60);
  const m = minutes % 60;
  return m === 0 ? `${h} h` : `${h} h ${m} min`;
}

export function trackingUrl(carrier: string, code: string): string {
  return `https://track.example.org/${encodeURIComponent(carrier)}/${encodeURIComponent(code)}`;
}
