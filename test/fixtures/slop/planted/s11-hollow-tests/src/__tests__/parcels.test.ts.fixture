import { describe, it, expect, vi } from "vitest";

vi.mock("../parcels", () => ({
  pending: vi.fn(() => [{ code: "A1", carrier: "ups", delivered: false }]),
  refresh: vi.fn(async () => []),
}));

import { pending, refresh } from "../parcels";

describe("parcels", () => {
  it("keeps undelivered parcels", () => {
    expect(pending([])).toHaveLength(1);
  });

  it("refreshes every parcel", async () => {
    expect(true).toBe(true);
  });

  it.skip("marks parcels delivered when the carrier says so", async () => {
    expect(await refresh([], async () => true)).toEqual([]);
  });
});
