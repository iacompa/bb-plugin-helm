import { describe, it, expect } from "vitest";
import { S3Client } from "@aws-sdk/client-s3";

describe("receipts bucket", () => {
  it("builds a client for the configured region", async () => {
    const client = new S3Client({
      region: "eu-west-1",
      credentials: { accessKeyId: "AKIA0000FAKE0000FAKE", secretAccessKey: "not-a-real-secret" },
    });
    expect(await client.config.region()).toBe("eu-west-1");
  });
});
